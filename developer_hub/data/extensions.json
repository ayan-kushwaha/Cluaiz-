{
  "group": "Extensions",
  "endpoints": [
    {
      "method": "GET",
      "path": "/v1/extensions/list",
      "desc": "Returns a list of all installed extensions.",
      "docs_url": "https://cdn.jsdelivr.net/gh/cluaiz/cluaiz@main/docs/extensions/list.md",
      "params": [],
      "response": "{\n  \"extensions\": [\n    {\n      \"id\": \"ext_db_99\",\n      \"name\": \"Cluaiz DB Manager\",\n      \"version\": \"2.0.1\",\n      \"status\": \"active\",\n      \"author\": \"Cluaiz\"\n    }\n  ]\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET http://localhost:8000/v1/extensions/list"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.get('http://localhost:8000/v1/extensions/list')\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/extensions/list');\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let res = reqwest::get(\"http://localhost:8000/v1/extensions/list\").await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/v1/extensions/install",
      "desc": "Installs an extension.",
      "docs_url": "https://cdn.jsdelivr.net/gh/cluaiz/cluaiz@main/docs/extensions/install.md",
      "params": [
        { "name": "extension_uri", "type": "string", "req": true, "desc": "URI of the extension.", "default": "https://registry.cluaiz.com/extensions/cluaiz-db" }
      ],
      "request_payload": "{\n  \"extension_uri\": \"https://registry.cluaiz.com/extensions/cluaiz-db\"\n}",
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"Extension installed and loaded.\",\n  \"extension_id\": \"ext_db_99\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X POST http://localhost:8000/v1/extensions/install \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"extension_uri\": \"https://registry.cluaiz.com/extensions/cluaiz-db\"}'"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.post('http://localhost:8000/v1/extensions/install', json={\"extension_uri\": \"https://registry.cluaiz.com/extensions/cluaiz-db\"})\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/extensions/install', {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ extension_uri: 'https://registry.cluaiz.com/extensions/cluaiz-db' })\n});\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let client = reqwest::Client::new();\nlet res = client.post(\"http://localhost:8000/v1/extensions/install\")\n    .json(&serde_json::json!({ \"extension_uri\": \"https://registry.cluaiz.com/extensions/cluaiz-db\" }))\n    .send()\n    .await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "DELETE",
      "path": "/v1/extensions/remove",
      "desc": "Removes an extension.",
      "docs_url": "https://cdn.jsdelivr.net/gh/cluaiz/cluaiz@main/docs/extensions/remove.md",
      "params": [
        { "name": "extension_id", "type": "string", "req": true, "desc": "ID of the extension.", "default": "ext_db_99" }
      ],
      "request_payload": "{\n  \"extension_id\": \"ext_db_99\"\n}",
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"Extension successfully removed.\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X DELETE http://localhost:8000/v1/extensions/remove \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"extension_id\": \"ext_db_99\"}'"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.delete('http://localhost:8000/v1/extensions/remove', json={\"extension_id\": \"ext_db_99\"})\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/extensions/remove', {\n  method: 'DELETE',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ extension_id: 'ext_db_99' })\n});\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let client = reqwest::Client::new();\nlet res = client.delete(\"http://localhost:8000/v1/extensions/remove\")\n    .json(&serde_json::json!({ \"extension_id\": \"ext_db_99\" }))\n    .send()\n    .await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/v1/extensions/cache",
      "desc": "Lists the active caches for extensions.",
      "docs_url": "https://cdn.jsdelivr.net/gh/cluaiz/cluaiz@main/docs/extensions/cache_list.md",
      "params": [],
      "response": "{\n  \"caches\": [\n    {\n      \"extension_id\": \"ext_db_99\",\n      \"cache_files\": [\"cache.bin\", \"db_index.bin\"],\n      \"total_size_mb\": 45.2\n    }\n  ]\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET http://localhost:8000/v1/extensions/cache"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.get('http://localhost:8000/v1/extensions/cache')\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/extensions/cache');\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let res = reqwest::get(\"http://localhost:8000/v1/extensions/cache\").await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "DELETE",
      "path": "/v1/extensions/cache",
      "desc": "Clears extension caches.",
      "docs_url": "https://cdn.jsdelivr.net/gh/cluaiz/cluaiz@main/docs/extensions/cache_clear.md",
      "params": [
        { "name": "extension_id", "type": "string", "req": false, "desc": "Target specific extension cache.", "default": "cluaiz-db" },
        { "name": "all", "type": "boolean", "req": false, "desc": "Clear all orphaned caches globally.", "default": false }
      ],
      "request_payload": "{\n  \"extension_id\": \"ext_db_99\",\n  \"all\": false\n}",
      "response": "{\n  \"status\": \"success\",\n  \"freed_space_mb\": 45.2,\n  \"message\": \"Cache cleared successfully.\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X DELETE http://localhost:8000/v1/extensions/cache \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"extension_id\": \"ext_db_99\", \"all\": false}'"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.delete('http://localhost:8000/v1/extensions/cache', json={\"extension_id\": \"ext_db_99\", \"all\": False})\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/extensions/cache', {\n  method: 'DELETE',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ extension_id: 'ext_db_99', all: false })\n});\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let client = reqwest::Client::new();\nlet res = client.delete(\"http://localhost:8000/v1/extensions/cache\")\n    .json(&serde_json::json!({ \"extension_id\": \"ext_db_99\", \"all\": false }))\n    .send()\n    .await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    }
  ]
}

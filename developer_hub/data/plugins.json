{
  "group": "Native Plugins",
  "endpoints": [
    {
      "method": "GET",
      "path": "/v1/plugins/list",
      "desc": "Returns a list of all active native plugins.",
      "docs_url": "/docs/reference/api.md",
      "params": [],
      "response": "{\n  \"plugins\": [\n    {\n      \"id\": \"plg_99a\",\n      \"name\": \"Web Scraper\",\n      \"version\": \"1.2.0\",\n      \"status\": \"active\",\n      \"author\": \"Cluaiz Core\"\n    }\n  ]\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET http://localhost:8000/v1/plugins/list"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.get('http://localhost:8000/v1/plugins/list')\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/plugins/list');\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let res = reqwest::get(\"http://localhost:8000/v1/plugins/list\").await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/v1/plugins/install",
      "desc": "Installs a native plugin.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        { "name": "plugin_uri", "type": "string", "req": true, "desc": "URI of the plugin.", "default": "https://registry.cluaiz.com/plugins/web-scraper-v1.zip" }
      ],
      "request_payload": "{\n  \"plugin_uri\": \"https://registry.cluaiz.com/plugins/web-scraper-v1.zip\"\n}",
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"Plugin Web Scraper installed successfully.\",\n  \"plugin_id\": \"plg_99a\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X POST http://localhost:8000/v1/plugins/install \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"plugin_uri\": \"https://registry.cluaiz.com/plugins/web-scraper-v1.zip\"}'"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.post('http://localhost:8000/v1/plugins/install', json={\"plugin_uri\": \"https://registry.cluaiz.com/plugins/web-scraper-v1.zip\"})\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/plugins/install', {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ plugin_uri: 'https://registry.cluaiz.com/plugins/web-scraper-v1.zip' })\n});\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let client = reqwest::Client::new();\nlet res = client.post(\"http://localhost:8000/v1/plugins/install\")\n    .json(&serde_json::json!({ \"plugin_uri\": \"https://registry.cluaiz.com/plugins/web-scraper-v1.zip\" }))\n    .send()\n    .await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "DELETE",
      "path": "/v1/plugins/remove",
      "desc": "Removes a native plugin.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        { "name": "plugin_id", "type": "string", "req": true, "desc": "ID of the plugin to remove.", "default": "plg_99a" }
      ],
      "request_payload": "{\n  \"plugin_id\": \"plg_99a\"\n}",
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"Plugin removed from the system.\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X DELETE http://localhost:8000/v1/plugins/remove \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"plugin_id\": \"plg_99a\"}'"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.delete('http://localhost:8000/v1/plugins/remove', json={\"plugin_id\": \"plg_99a\"})\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/plugins/remove', {\n  method: 'DELETE',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ plugin_id: 'plg_99a' })\n});\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let client = reqwest::Client::new();\nlet res = client.delete(\"http://localhost:8000/v1/plugins/remove\")\n    .json(&serde_json::json!({ \"plugin_id\": \"plg_99a\" }))\n    .send()\n    .await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/v1/plugins/cache",
      "desc": "Lists the active caches for plugins.",
      "docs_url": "/docs/reference/api.md",
      "params": [],
      "response": "{\n  \"caches\": [\n    {\n      \"plugin_id\": \"plg_99a\",\n      \"plugin_name\": \"Web Scraper\",\n      \"cache_files\": [\"cache.bin\", \"temp_data.db\"],\n      \"total_size_mb\": 12.5\n    }\n  ]\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET http://localhost:8000/v1/plugins/cache"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.get('http://localhost:8000/v1/plugins/cache')\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/plugins/cache');\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let res = reqwest::get(\"http://localhost:8000/v1/plugins/cache\").await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "DELETE",
      "path": "/v1/plugins/cache",
      "desc": "Clears plugin caches.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        { "name": "plugin_id", "type": "string", "req": false, "desc": "Target specific plugin cache.", "default": "web-scraper" },
        { "name": "all", "type": "boolean", "req": false, "desc": "Clear all orphaned caches globally.", "default": false }
      ],
      "request_payload": "{\n  \"plugin_id\": \"plg_99a\",\n  \"all\": false\n}",
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"Cache cleared for plugin plg_99a.\",\n  \"freed_space_mb\": 12.5\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X DELETE http://localhost:8000/v1/plugins/cache \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"plugin_id\": \"plg_99a\", \"all\": false}'"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.delete('http://localhost:8000/v1/plugins/cache', json={\"plugin_id\": \"plg_99a\", \"all\": False})\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/plugins/cache', {\n  method: 'DELETE',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ plugin_id: 'plg_99a', all: false })\n});\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let client = reqwest::Client::new();\nlet res = client.delete(\"http://localhost:8000/v1/plugins/cache\")\n    .json(&serde_json::json!({ \"plugin_id\": \"plg_99a\", \"all\": false }))\n    .send()\n    .await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    }
  ]
}
